# ============================================================
#  Шаблон настроек TG_Tickets для хостинга.
#  Скопировать в .env и заполнить своими значениями.
#  Файл .env НЕ коммитить в репозиторий.
# ============================================================

# --- Telegram ---
# Токен от @BotFather
BOT_TOKEN=123456789:AA-ваш-токен
# Кому разрешено пользоваться ботом (Telegram ID через запятую)
ALLOWED_USER_IDS=406559399
# Администраторы (могут менять приоритеты/назначать)
ADMIN_USER_IDS=406559399
# Куда слать уведомления о запуске/остановке (пусто — не слать)
NOTIFY_CHAT_IDS=
NOTIFY_ON_START=true
NOTIFY_ON_STOP=true

# --- Сеть ---
# На сервере за рубежом прокси и прибитый IP НЕ нужны — оставить пустыми.
# PROXY_URL заполняется только если сервер в РФ и Telegram недоступен напрямую.
PROXY_URL=
TELEGRAM_API_IP=

# --- Данные ---
# Куда писать состояние (sd_state.json, tickets.json).
# Пусто — папка data/ рядом с кодом. На хостинге с томом: DATA_DIR=/data
DATA_DIR=
# Порт мини-HTTP сервера для «живости» сервиса (Render/HF). 0 — не запускать.
PORT=0
# Токен для доступа к подробному статусу на /health?token=...
# Без него отдаётся только {"status":"ok"} — публичный адрес не раскрывает данные.
HEALTH_TOKEN=
# Простой короче этого не считается падением
OUTAGE_MIN_SECONDS=10
# Не чаще одного сообщения о падении за это время (защита от спама)
OUTAGE_COOLDOWN_SECONDS=600

# --- Заявки ---

# --- LLM-диалог (необязательно) ---
# Без LLM_API_KEY бот работает как монитор заявок: на текст отвечает подсказкой.
# Подходит любой OpenAI-совместимый API (OpenAI, OpenRouter, локальный сервер).
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1024
LLM_SYSTEM_PROMPT=

# --- ServiceDesk ---
SD_ENABLED=true
SD_BASE_URL=https://sd.servionica.ru
SD_LOGIN=
SD_PASSWORD=
# Метод авторизации в SD. simpleone — /v1/auth/login (рабочий для
# sd.servionica.ru). auto — перебор всех 5 методов (только для отладки,
# в бою создаёт лишние логины).
SD_AUTH_METHOD=simpleone
# После скольких неудачных проверок подряд ставить мониторинг на паузу.
SD_MAX_FAILURES=2
# Слать ли уведомление в Telegram при автопаузе.
SD_PAUSE_NOTIFY=true
# Интервал опроса, секунд (минимум 10)
SD_CHECK_INTERVAL=60
# Локальный reverse-proxy для SD: снимает битый CSP-заголовок.
# 0 — выключен; на Render и локально включается 8765.
SD_PROXY_PORT=0
# Куда слать уведомления SD (пусто — в ALLOWED_USER_IDS)
SD_NOTIFY_CHAT_IDS=
SD_VIEW=Default
# Проверять сертификат SD. Отключать только при самоподписанном сертификате:
# через это соединение уходят логин и пароль.
SD_VERIFY_SSL=true
# Условие фильтра из ссылки SD (без ORDER BY)
SD_CONDITION=
# Первый запуск: запомнить текущие заявки молча, без рассылки истории
SD_SEED_ON_FIRST_RUN=true
# SLA: предупреждение за N часов до дедлайна СУТС (0 — только «сгорела»)
SD_SLA_ENABLED=true
SD_SLA_WARN_HOURS=2
# Часовой пояс SD: дедлайны приходят без зоны. На Windows без базы IANA
# Europe/Moscow работает через фиксированный UTC+3 (Москва без перехода на летнее).
SD_TIMEZONE=Europe/Moscow
